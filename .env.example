# 任何 OpenAI 兼容接口都行，教程用 DeepSeek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat

# 第 7 章起：内部接口口令，Go 主服务与本服务共享
INTERNAL_TOKEN=dev
# 回调地址，本地演示时指向本服务自带的 /fake-go
API_BASE_URL=http://127.0.0.1:8000

# 第 9 章：超时（秒）与熔断
LLM_TIMEOUT=30
TUTOR_TIMEOUT=60
BREAKER_FAIL_MAX=3
BREAKER_COOLDOWN=30
